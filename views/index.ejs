<%- include("partials/headers.ejs") %>

  <h2>Publish your passions, your way</h2>
  <h3>Create a unique and beautiful blog easily.</h3>

  <a href="/create" class="customLink">Create the blog</a>

  <% if (locals.allPosts && locals.allPosts.length !=0) { %>
    <h3>Read your Stories</h3>
    <% allPosts.forEach(function(post) { %>
      <div>
        <h4>
          <%= post.title %>
        </h4>

        <a href="/read/<%= post.title %>" class="customLink">Read Post</a>
      </div>
      <% }) %>
        <% } %>

          <%- include("partials/footers.ejs") %>