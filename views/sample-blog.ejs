<%- include("partials/headers.ejs") %>
  <h2>Write the Stories</h2>

  <form method="POST" action="/post-and-create">
    <input type="text" name="postTitle" placeholder="Enter Blog Title" required>

    <textarea name="userPost" class="feedback-input"
      placeholder="Write your story here..."><%= myEssay.content %></textarea>

    <input type="submit" class="customLink" value="Publish the blog">
  </form>

  <%- include("partials/footers.ejs") %>